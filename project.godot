; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dino_track_racing"
config/version="0.1.3"
config/tags=PackedStringArray("proper_project", "school")
run/main_scene="uid://wwcxxmjxspog"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://b7golcedx5sk1"
config/size/mode=0

[autoload]

Globals="*res://common/autoload/globals.gd"
LevelManager="*res://common/autoload/level_manager.gd"
SettingsManager="*res://common/autoload/settings_manager.gd"
AudioWorld3d="*res://common/autoload/audio_world_3d/audio_world_3d.tscn"
AudioWorldUi="*res://common/autoload/audio_world_ui/audio_world_ui.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "pink",
"res://common/": "gray",
"res://debug/": "red",
"res://entities/": "blue",
"res://environment/": "purple",
"res://gui/": "green",
"res://levels/": "orange"
}

[global_group]

car=""
finish_line=""
checkpoint=""
track=""
grass=""
va_listener=""

