[layer_names]

3d_render/layer_1="default"
3d_render/layer_2="allow_shadows"
3d_physics/layer_1="road"
3d_physics/layer_2="car"
3d_physics/layer_3="track_follow"
3d_physics/layer_4="item"
3d_physics/layer_5="hitbox"
3d_physics/layer_6="walls"

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Jolt Physics"
3d/default_gravity=15.0

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/decals/filter=2
textures/light_projectors/filter=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
